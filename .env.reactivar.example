# -----------------------------------------------------------------------------
#  Plantilla para scripts/reactivar.mjs
#  Copia este archivo a `.env.reactivar` y rellena los valores.
#  El script te preguntará interactivamente los que dejes en blanco.
# -----------------------------------------------------------------------------

# Personal Access Token de Supabase
# Genéralo en: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ID de la organización de Supabase (opcional; si sólo tienes 1, el script la elige sola)
SUPABASE_ORG_ID=

# Password de Postgres del nuevo proyecto (invéntala larga; se guarda en Supabase)
SUPABASE_DB_PASSWORD=

# Nombre del proyecto que aparecerá en Supabase (por defecto: administracion-saladino)
SUPABASE_PROJECT_NAME=administracion-saladino

# Región del proyecto Supabase (us-east-1 = Virginia, la más cerca a México)
SUPABASE_REGION=us-east-1

# Token de Vercel
# Genéralo en: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Nombre del proyecto en Vercel (el que ya está deployado)
VERCEL_PROJECT_NAME=proyecto-german

# Solo si el proyecto Vercel está dentro de un equipo (no personal): pon el team ID
VERCEL_TEAM_ID=

# Credenciales del login que va a usar Germán
USER_EMAIL=foge890210sh7@gmail.com
USER_PASSWORD=Saladino2026!
